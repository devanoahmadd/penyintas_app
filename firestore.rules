rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jendela hari yang boleh ditulis. `request.time` UTC sementara `dayKey`
    // wall-clock lokal device — selisihnya maksimal ±14 jam, jadi kelonggaran
    // 2 hari di atas lebih dari cukup. Aritmetika lewat timestamp, BUKAN
    // `dayKey + 1`: 20260930 + 1 tidak sama dengan 20261001.
    function maxWritableDayKey() {
      let t = request.time + duration.value(2, 'd');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // Batas BAWAH (Rev 2). Sebuah penanda hanya pernah dibuat untuk "hari ini"
    // di device, jadi dokumen yang lebih tua dari setahun tidak bisa sah —
    // 400 hari sudah jauh melampaui jendela pemulihan penanda offline yang
    // belum sempat terkirim (antreannya sendiri kedaluwarsa dalam 7 hari,
    // `sync_service.dart:61-77`).
    //
    // Kenapa dibatasi sama sekali: `dayKey >= 20000101` mengizinkan klien
    // yang rusak — atau iseng — menulis PULUHAN RIBU dokumen bertanggal
    // lampau. Isinya memang hanya merugikan akun user sendiri, tapi
    // kuota dan tagihan Firestore-nya milik pemilik aplikasi. Pagarnya murah
    // dan tidak menghilangkan satu pun jalur sah.
    //
    // Sengaja BUKAN `kStreakEpochDay`: menyalin konstanta Dart ke rules
    // membuat dua tempat yang harus diubah bersamaan saat Task 18 mengunci
    // epoch — jenis kopling yang cepat atau lambat terlupakan.
    function minWritableDayKey() {
      let t = request.time - duration.value(400, 'd');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /transactions/{txId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /budget_settings/{settingId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      // Batas kategori (ditulis client, dibaca CF budgetLimitWarning).
      // Owner-check + validasi tipe ringan pada field yang dibaca server
      // (limitAmount, isEnabled). TANPA hasOnly: field baru tetap lolos agar
      // rules tak ketinggalan dari model (hindari drift permission-denied).
      match /budget_limits/{categoryName} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        // delete dipisah: saat delete request.resource.data == null,
        // sehingga validasi tipe tak bisa (dan tak perlu) diterapkan.
        allow delete: if request.auth != null
          && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.limitAmount is number
          && request.resource.data.limitAmount >= 0
          && request.resource.data.isEnabled is bool;
      }

      // Tujuan tabungan (B1 goal cloud sync) — ditulis & dibaca client saja,
      // doc ID = firestoreId (UUID) dari GoalModel. Pola budget_limits:
      // owner-check + validasi tipe ringan pada field inti, TANPA hasOnly
      // (field baru tetap lolos — hindari drift permission-denied).
      match /goals/{goalId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        // delete dipisah: saat delete request.resource.data == null,
        // sehingga validasi tipe tak bisa (dan tak perlu) diterapkan.
        allow delete: if request.auth != null
          && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0
          && request.resource.data.isCompleted is bool
          && request.resource.data.targetDate is number
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      // Penanda "hari ini tidak ada pengeluaran" (A4 Konsistensi). Satu
      // dokumen per hari, doc-id = dayKey yyyyMMdd. Pola goals: owner-check +
      // validasi tipe ringan pada field inti, TANPA hasOnly (field baru tetap
      // lolos — hindari drift permission-denied yang pernah terjadi pada
      // budget_limits).
      match /streak_marks/{dayKey} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        // delete dipisah: saat delete request.resource.data == null.
        allow delete: if request.auth != null
          && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.dayKey is int
          && request.resource.data.dayKey >= minWritableDayKey()
          && request.resource.data.dayKey <= maxWritableDayKey()
          && string(request.resource.data.dayKey) == dayKey
          && request.resource.data.markedAt is number
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && request.resource.data.timezone.size() <= 64
          && request.resource.data.updatedAt is number;
      }

      // A4 Fase 2 — satu dokumen per minggu. Pola bills/streak_marks: owner-check
      // + validasi tipe ringan, TANPA hasOnly. Field baru di masa depan tidak
      // boleh mendadak memicu permission-denied.
      // Field opsional divalidasi HANYA bila hadir: baris `held` memang tak punya
      // category/targetAmount/baselineAmount.
      match /challenges/{weekKey} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.weekKey is int
          && request.resource.data.weekKey >= minWritableDayKey()
          && request.resource.data.weekKey <= maxWritableDayKey()
          && string(request.resource.data.weekKey) == weekKey
          && request.resource.data.status in ['active','achieved','missed','held','skipped']
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && request.resource.data.timezone.size() <= 64
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && (!('category' in request.resource.data) || (
               request.resource.data.category is string
               && request.resource.data.category.size() > 0
               && request.resource.data.category.size() <= 64))
          && (!('targetAmount' in request.resource.data) || (
               request.resource.data.targetAmount is int
               && request.resource.data.targetAmount >= 0))
          && (!('baselineAmount' in request.resource.data) || (
               request.resource.data.baselineAmount is int
               && request.resource.data.baselineAmount >= 0))
          && (!('finalSpent' in request.resource.data) || (
               request.resource.data.finalSpent is int
               && request.resource.data.finalSpent >= 0));
      }

      // Tagihan/kewajiban rutin (A1 bills). Pola goals: owner-check + validasi
      // tipe ringan pada field inti, TANPA hasOnly (field baru tetap lolos —
      // hindari drift permission-denied).
      match /bills/{billId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        // delete dipisah: saat delete request.resource.data == null,
        // sehingga validasi tipe tak bisa (dan tak perlu) diterapkan.
        allow delete: if request.auth != null
          && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.estimatedAmount is number
          && request.resource.data.estimatedAmount >= 0
          && request.resource.data.category is string
          && request.resource.data.dueDate is number
          && request.resource.data.status in ['active', 'completed']
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number;
      }

      // Token FCM per-device (ditulis client, dibaca+prune CF via admin SDK).
      // Pola budget_limits: owner-check + validasi tipe ringan, TANPA hasOnly
      // (hindari drift-trap; longgar by design — owner-scoped, bukan celah).
      match /fcmTokens/{token} {
        allow read, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.token is string
          && request.resource.data.platform in ['android', 'ios'];
      }

      match /settings/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /preferences/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        // Singleton — row selalu ada; tak ada jalur delete dari client. Eksplisit
        // (bukan efek samping dari validasi data null saat delete). (M3)
        allow delete: if false;

        allow create, update: if request.auth != null && request.auth.uid == userId
          && docId == 'current'
          && request.resource.data.keys().hasAll([
               'timezone','baseCurrency','homeCurrency','language',
               'currentCountry','homeCountry','isPerantau',
               'profileCompleted','schemaVersion','updatedAt'])
          && request.resource.data.keys().hasOnly([
               'timezone','baseCurrency','homeCurrency','language',
               'displayName','status','currentCountry','currentCity',
               'homeCountry','homeCity','isPerantau',
               'profileCompleted','schemaVersion','updatedAt'])
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && request.resource.data.timezone.size() <= 64
          && request.resource.data.baseCurrency is string
          && request.resource.data.baseCurrency.size() == 3
          && request.resource.data.homeCurrency is string
          && request.resource.data.homeCurrency.size() == 3
          && request.resource.data.language in ['id', 'en']
          && request.resource.data.currentCountry is string
          && request.resource.data.currentCountry.size() == 2
          && request.resource.data.homeCountry is string
          && request.resource.data.homeCountry.size() == 2
          && request.resource.data.isPerantau is bool
          && request.resource.data.profileCompleted is bool
          // Kunci ke versi yg memang client tahu (v1). Longgarkan HANYA saat
          // format dokumen benar-benar naik versi. (M4) — paling ketat, paling aman.
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updatedAt == request.time
          // Field opsional: jika hadir, wajib string ber-bound (defense-in-depth, M2).
          && (!('currentCity' in request.resource.data)
               || (request.resource.data.currentCity is string && request.resource.data.currentCity.size() <= 64))
          && (!('homeCity' in request.resource.data)
               || (request.resource.data.homeCity is string && request.resource.data.homeCity.size() <= 64))
          && (!('displayName' in request.resource.data)
               || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80))
          && (!('status' in request.resource.data) || request.resource.data.status in ['student', 'worker']);
      }

      // Ditulis oleh Cloud Functions (admin SDK) — Flutter client hanya perlu read
      match /meta/{docId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false; // hanya server (admin SDK bypass rules)
      }

      // Cache insight Vertex AI — ditulis server, dibaca client
      match /insights/{cacheKey} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      // Cache survival tips Vertex AI — ditulis server, dibaca client
      match /survival_tips/{cacheKey} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
